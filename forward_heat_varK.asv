function [x, t, U, full_A, rhs, biot] = forward_heat_varK( ...
    k0, k1, N, dt, T, u0fun, T_infy, h, big_U, L)

    % --- sanity check ---
    if k0 <= abs(k1)
        error('Need k0 > |k1| so that k(x) stays positive.');
    end

    % --- constants / grid ---
    rho = 8.9;
    Cp  = 385;

    dx = 1/N;
    x  = (0:N)' * dx;          % (N+1)x1 grid nodes
    xi = x(2:N);               % interior nodes

    % --- time ---
    Nt = round(T/dt);
    t  = (0:Nt) * dt;

    % --- initial condition (dimensionless) ---
    U = zeros(N+1, Nt+1);
    U(2:N,1) = u0fun(xi);
    U = (U - T_infy) ./ big_U;

    % --- face (midpoint) diffusivity / conductivity / Biot ---
    xface     = 0.5 * (x(1:N) + x(2:N+1));          % N faces
    alphaFace = k0 + k1 .* sin(pi .* xface);        % diffusivity on faces
    kFace     = rho * Cp .* alphaFace;              % conductivity on faces
    biot      = (h * L) ./ kFace;                   % Biot on faces

    % --- interior operator matrix (N-1 unknowns: i=2..N) ---
    lam   = dt / dx^2;
    aL    = alphaFace(1:N-1);   % i-1/2
    aR    = alphaFace(2:N);     % i+1/2

    main  = 1 + lam * (aL + aR);
    low   = -lam * aL;
    up    = -lam * aR;

    Aint = spdiags([low, main, up], [-1 0 1], N-1, N-1);

    % --- build full system with 2 extra DOFs: (u0, interior..., uN) ---
    % Size: (N+1)x(N+1)
    A = spalloc(N+1, N+1, 3*(N-1) + 10);

    % Put interior block into rows/cols 2..N
    A(2:N, 2:N) = Aint;

    % Robin boundary row at x=0 (your existing formula)
    % robin_row(1) = biot(1)*dx - alphaFace(1);
    % robin_row(2) = -alphaFace(1);
    A(1,1) = biot(1)*dx - alphaFace(1);
    A(1,2) = -alphaFace(1);

    % Couple Robin equation into first interior equation
    A(2,1) = low(1);

    % Neumann at x=1
    A(end,end)   = 1;
    A(end,end-1) = -1;

    % Couple last interior equation to boundary uN (your existing A(end-1,end)=up(1))
    A(end-1,end) = up(1);

    full_A = full(A);  % only if you truly need it dense (debug/printing)

    % --- time stepping ---
    rhs = zeros(N+1,1);
    for n = 1:Nt
        rhs(:) = U(:,n);

        % keep these only if they are truly correct for your BC equations
        rhs(1)   = 0;
        rhs(end) = 0;

        U(:,n+1) = A \ rhs;
    end

    % --- back to dimensional temperature ---
    U = big_U .* U + T_infy;
end

